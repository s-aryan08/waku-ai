# ==========================================
# Waku AI Companion - Environment Configuration
# ==========================================

# Required: Google Gemini API Key
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model identifier (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional: Server host & port (default: 0.0.0.0 and 5000)
HOST=0.0.0.0
PORT=5000

# Optional: Enable Flask debug mode (true/false)
FLASK_DEBUG=false
